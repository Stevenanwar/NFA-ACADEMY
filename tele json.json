{
  "name": "Telegram ChatBot - AI Agent dengan Google Sheets",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "t1-telegram-trigger",
      "name": "Telegram Trigger"
    },
    {
      "parameters": {
        "promptType": "custom",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "Kamu adalah Asisten AI Informasi Pelatihan dan Kursus. Tugasmu membantu pengguna menjawab pertanyaan tentang jenis program, nama pelatihan, topik, dan harga dari Google Sheets. Kamu WAJIB menggunakan Tool Google Sheets untuk mengambil data dari spreadsheet sebelum merespons."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        240,
        0
      ],
      "id": "a1-ai-agent",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash"
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        140,
        220
      ],
      "id": "m1-gemini-model",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "contextWindowLength": 5
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        280,
        220
      ],
      "id": "mem1-buffer-memory",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "resource": "sheetWithinDocument",
        "operation": "getRows",
        "documentId": {
          "__rl": true,
          "value": "n8n 1",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.toolGoogleSheets",
      "typeVersion": 1,
      "position": [
        420,
        220
      ],
      "id": "tool1-google-sheets",
      "name": "Google Sheets"
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger\"].json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        500,
        0
      ],
      "id": "t2-telegram-send",
      "name": "Telegram"
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}